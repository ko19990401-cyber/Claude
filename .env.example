# ---------------------------------------------------------------------------
# 長時間音声 文字起こし・要約ツール  設定ファイル
# このファイルを .env にコピーして値を埋めてください。
# .env は .gitignore 済みです。絶対にコミットしないでください。
# ---------------------------------------------------------------------------

# --- ASR（文字起こし）---------------------------------------------------
# elevenlabs / assemblyai / deepgram のいずれか
ASR_PROVIDER=elevenlabs

# 第一候補：ElevenLabs Scribe（話者分離が基本料金に込み）
ELEVENLABS_API_KEY=

# 対抗馬：AssemblyAI（非同期バッチAPI。中断・再開に最も強い）
ASSEMBLYAI_API_KEY=

# 対抗馬：Deepgram Nova-3
DEEPGRAM_API_KEY=

# 認識言語（ja / en / auto）
ASR_LANGUAGE=ja

# --- LLM（要約）---------------------------------------------------------
ANTHROPIC_API_KEY=

# 既定の要約モデル。プリセットごとにUIから変更できます。
SUMMARY_MODEL=claude-opus-5
# low / medium / high / xhigh / max
SUMMARY_EFFORT=medium

# --- 公開設定（スマホなど外部から使う場合）-------------------------------
# Basic認証。両方を設定すると全ページ・全APIに認証がかかります。
# 公開環境では必ず設定してください（HTTPS必須）。
AUTH_USER=
AUTH_PASSWORD=
# true にすると、認証が未設定のままではサーバが起動しません。
REQUIRE_AUTH=

# --- 動作設定 -----------------------------------------------------------
PORT=8787
# コンテナやVPSで外部から接続する場合は 0.0.0.0
HOST=127.0.0.1
DATA_DIR=./data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# 為替（コスト試算の円換算に使用）
USD_JPY=150

# 階層要約に切り替える全文の文字数しきい値
HIERARCHICAL_THRESHOLD=120000
# 階層要約時の分割サイズ／オーバーラップ／並列数
CHUNK_CHARS=20000
CHUNK_OVERLAP_CHARS=400
MAP_CONCURRENCY=4
